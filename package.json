{
  "name": "@lyzz0612/agent-config-sync",
  "version": "0.1.1",
  "description": "Sync a single source of AI editor configuration to Cursor, Claude Code, Codex and Qoder.",
  "keywords": [
    "ai",
    "cli",
    "cursor",
    "claude",
    "codex",
    "qoder",
    "config",
    "sync"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyzz0612/agent-config-sync.git"
  },
  "bugs": {
    "url": "https://github.com/lyzz0612/agent-config-sync/issues"
  },
  "homepage": "https://github.com/lyzz0612/agent-config-sync#readme",
  "bin": {
    "agentcs": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
